# ---------- Django ----------
SECRET_KEY=change-me-to-a-random-string
DEBUG=True
ALLOWED_HOSTS=*

# ---------- Database ----------
# local test = sqlite (leave DB_NAME blank), EC2 = postgres on RDS
DB_ENGINE=sqlite
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# ---------- Microsoft Outlook / Graph ----------
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MAILBOX_USER_EMAIL=ra-rpatsaspacteam@ITS.JNJ.com
MAIL_TARGET_FOLDER=OPTIC BOT
# child folder under MAIL_TARGET_FOLDER; order emails are moved here, then ingested from here
MAIL_ORDERS_FOLDER=01 New Orders
MAIL_POLL_MINUTES=5
MAIL_BATCH_SIZE=20
# FIRST RUN ONLY (no watermark yet): how many DAYS of OPTIC BOT mail to read.
#   1 = last day, 7 = last week, 0 = everything whatever its age. Older mail is never touched.
MAIL_FIRST_RUN_DAYS=0
# TEST SWITCH: handle at most this many emails in TOTAL, then stop (0 = no limit)
MAIL_TEST_LIMIT=0
# later polls fetch mail received since (watermark - overlap)
MAIL_OVERLAP_MINUTES=60
# give up on an email after this many hours of continuous failure; also the sweep depth behind the watermark
MAIL_RETRY_WINDOW_HOURS=72
# cosmetic only - read state no longer decides what gets fetched
MARK_MAIL_AS_READ=True
# body is always requested as PLAIN TEXT, never HTML (see services.py Section B)
INCLUDE_BODY_AS_CONTEXT=True
MAX_BODY_CHARS=4000

# ---------- Attachments ----------
# one order document per attachment; anything not on this list is ignored
ALLOWED_EXTENSIONS=pdf,docx,doc,xlsx,xls,csv,png,jpg,jpeg
# NO SIZE LIMITS. An order attachment may be 2 KB or 50 MB - it is always
# downloaded, stored and processed. Signature logos are excluded by the
# inline check below, not by size.
SKIP_INLINE_ATTACHMENTS=True
# Not a filter. Largest document the LLM accepts in one call; a bigger file
# is still saved, and the order is flagged FAILED for manual entry.
LLM_MAX_DOCUMENT_MB=4.5

# ---------- AWS ----------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_INPUT_BUCKET=
S3_OUTPUT_BUCKET=

# ---------- Storage provider ----------
# "s3" (default) writes to the S3 buckets above, using real AWS.
# "local" writes to a folder on disk instead - same bucket names, same
# object keys, so testing with no AWS account produces the identical layout
# a real S3 run would. Switch back to "s3" any time, no other change needed.
STORAGE_PROVIDER=s3
LOCAL_STORAGE_DIR=./local_storage

# ---------- OE master (direct pgvector query) ----------
# Same Postgres instance as DB_HOST above - the backend opens its own
# connection and runs the cosine-similarity SQL itself (no separate
# service, no URL). Requires DB_ENGINE=postgres with the pgvector
# extension and the oe_master table - see PLAN.md Appendix A for the
# exact schema and services.py Section C for the query.
OE_MATCHING_ENABLED=True
# Must match whatever model/dimension oe_master.embedding was populated
# with, or every similarity score is meaningless.
OE_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
OE_EMBEDDING_DIMENSION=1024
OE_MATCH_THRESHOLD=0.82
OE_TOP_K=5
# LLM reasons over the top-k OE candidates on EVERY order (not just
# ambiguous ones) so there's always a human-readable reason for audit -
# see order.oe_match_reason. Set False to skip the LLM call and fall back
# to a bare OE_MATCH_THRESHOLD check (faster/free, shorter templated reason).
OE_RERANK_ENABLED=True
OE_RERANK_THRESHOLD=0.75

# ---------- Email triage (order vs communication) ----------
# Cheap LLM call on subject/body/attachment names BEFORE extraction, so
# delivery chasers, invoice queries and out-of-office replies never reach
# the expensive step. Only skips when CONFIDENT it is not an order; fails
# open (treats as an order) if the classifier is unavailable.
EMAIL_CLASSIFICATION_ENABLED=True
EMAIL_CLASSIFICATION_THRESHOLD=0.80

# ---------- LLM ----------
# bedrock  = boto3 bedrock-runtime.converse()
# gateway  = POST to the JnJ internal gateway (x-api-key)
LLM_PROVIDER=bedrock
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-5
LLM_GATEWAY_URL=https://genaiapigwna.jnj.com/model/{model}/converse
LLM_GATEWAY_API_KEY=
LLM_MAX_TOKENS=8192
LLM_TIMEOUT=120

# ---------- Business rules ----------
CONFIDENCE_THRESHOLD=0.85
REQUIRE_OE_MATCH=True

# ---------- Scheduler ----------
RUN_SCHEDULER=True


# ---------- SQS execution queue ----------
# False = the poller extracts inline (no queue).
# True  = the poller puts the document in S3 and sends one message per
#         order; a worker job drains the queue and does the extraction.
# RETRIES AND THE DLQ ARE CONFIGURED ON THE QUEUE IN AWS: set a redrive
# policy on the execution queue pointing at the DLQ with maxReceiveCount.
# The code never deletes a failed message, which is what makes that work.
USE_SQS=False
SQS_QUEUE_URL=
SQS_DLQ_URL=
# Must exceed how long one extraction takes, or SQS redelivers a message
# that is still being processed.
SQS_VISIBILITY_TIMEOUT=300
SQS_WAIT_TIME_SECONDS=20
SQS_MAX_MESSAGES=10
SQS_MAX_BATCHES=5
SQS_WORKER_MINUTES=1
